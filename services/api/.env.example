# ============================================================
# BankAssist AI — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# --- App ---
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_DEBUG=true
DEMO_MODE=false              # true = use mock LLM, clearly labelled in UI

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./bankassist.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bankassist

# --- Authentication ---
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider ---
LLM_PROVIDER=gemini           # gemini | openai | anthropic | mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Embedding ---
EMBEDDING_MODEL=all-MiniLM-L6-v2   # local sentence-transformer model
EMBEDDING_DIMENSION=384
VECTOR_STORE_TYPE=faiss              # faiss | chroma | pgvector
VECTOR_STORE_PATH=./data/vector_store

# --- RAG Retrieval ---
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.25

# --- Ingestion ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.html
MAX_PAGES_PER_DOCUMENT=200
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_REQUEST_SIZE_BYTES=1048576

# --- Seed data ---
SEED_ADMIN_EMAIL=admin@bankassist.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_AGENT_EMAIL=agent@bankassist.local
SEED_AGENT_PASSWORD=AgentPass123!

# --- Feature flags ---
ENABLE_REGISTRATION=true      # set false in production
ENABLE_AUDIT_LOGS=true
